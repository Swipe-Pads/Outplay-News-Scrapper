# SwipePads News Scraper - Environment Variables Template
# Copy this file to .env and fill in your actual values

# AI API Keys (choose one or configure both)
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# Scraper Configuration
SCRAPER_USER_AGENT=SwipePadsScraper/1.0
SCRAPER_RATE_LIMIT_SECONDS=2

# AI Model Configuration
CLAUDE_MODEL=claude-sonnet-4-20250514
API_RATE_LIMIT_SECONDS=1.0

# YouTube Data API v3 (free, 10k units/day)
# Get key: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_MAX_RESULTS=10

# Reddit API (free, read-only)
# Create app: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=OutplayNewsScraper/1.0
REDDIT_MIN_SCORE=5

# Strapi CMS sync
# Get token: Strapi Admin → Settings → API Tokens → Create (Full access)
STRAPI_URL=https://cms.outplay.game
STRAPI_API_TOKEN=your_strapi_api_token_here
STRAPI_PUBLISH=false

# Shopify blog publishing (weekly digest DRAFTS via Admin REST API 2026-01)
# Store domain (the *.myshopify.com domain, no https://)
SHOPIFY_STORE_DOMAIN=dkajsi-0s.myshopify.com
# Client credentials grant (preferred): a fresh access token (valid 24h) is
# exchanged on every publish run via POST /admin/oauth/access_token.
# App needs the write_content scope.
# Create: Shopify Admin → Settings → Apps and sales channels → Develop apps
SHOPIFY_CLIENT_ID=your_shopify_client_id_here
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret_here
# Optional static fallback token (shpat_...) — used only if client id/secret unset
SHOPIFY_ADMIN_TOKEN=
# Target blog ID (leave empty to use the store's first blog)
SHOPIFY_BLOG_ID=126947590478

# Database
DATABASE_PATH=data/articles.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/scraper.log

# Retention (days)
ARTICLE_RETENTION_DAYS=30
