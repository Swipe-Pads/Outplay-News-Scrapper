# SwipePads News Scraper - Environment Variables Template
# Copy this file to .env and fill in your actual values

# AI API Keys (choose one or configure both)
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# Scraper Configuration
SCRAPER_USER_AGENT=SwipePadsScraper/1.0
SCRAPER_RATE_LIMIT_SECONDS=2

# AI Model Configuration
# CLAUDE_MODEL is the fallback / digest model. Per-stage overrides below let the
# mechanical stages (summaries, scoring, extraction) run on a cheap model while
# digest composition — the only output readers see — keeps the strong one.
CLAUDE_MODEL=claude-sonnet-5
MODEL_SUMMARIZE=claude-haiku-4-5-20251001
MODEL_SCORE=claude-haiku-4-5-20251001
MODEL_EXTRACT=claude-haiku-4-5-20251001
# MODEL_DIGEST=claude-sonnet-5   # defaults to CLAUDE_MODEL
API_RATE_LIMIT_SECONDS=1.0

# Drop feed items older than this during discovery (dormant-feed guard)
MAX_ITEM_AGE_DAYS=21

# YouTube Data API v3 (free, 10k units/day)
# Get key: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_MAX_RESULTS=10

# Reddit API (free, read-only)
# Create app: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=OutplayNewsScraper/1.0
REDDIT_MIN_SCORE=5

# Strapi CMS sync
# Get token: Strapi Admin â†’ Settings â†’ API Tokens â†’ Create (Full access)
STRAPI_URL=https://cms.outplay.game
STRAPI_API_TOKEN=your_strapi_api_token_here
STRAPI_PUBLISH=false

# Shopify blog publishing (weekly digest DRAFTS via Admin REST API 2026-01)
# Store domain (the *.myshopify.com domain, no https://)
SHOPIFY_STORE_DOMAIN=dkajsi-0s.myshopify.com
# Client credentials grant (preferred): a fresh access token (valid 24h) is
# exchanged on every publish run via POST /admin/oauth/access_token.
# App needs the write_content scope.
# Create: Shopify Admin â†’ Settings â†’ Apps and sales channels â†’ Develop apps
SHOPIFY_CLIENT_ID=your_shopify_client_id_here
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret_here
# Optional static fallback token (shpat_...) â€” used only if client id/secret unset
SHOPIFY_ADMIN_TOKEN=
# Target blog ID (leave empty to use the store's first blog)
SHOPIFY_BLOG_ID=126947590478

# Weekly mailing via Cloudflare Email Service (public beta) — see docs/mailing.md
# Account ID: Cloudflare dashboard right rail
CF_ACCOUNT_ID=your_cf_account_id_here
# API token with "Email Sending: Send" + "Workers KV Storage: Read" permissions
CF_EMAIL_API_TOKEN=   # scope: Email Sending Send
CF_KV_API_TOKEN=      # scope: Workers KV readyour_cf_email_api_token_here
# KV namespace holding unsubscribe suppressions (created for the unsubscribe Worker)
KV_NAMESPACE_ID=your_kv_namespace_id_here
# Verified sender on your Email Service sending domain
MAIL_FROM=digest@mail.outplay.game
MAIL_FROM_NAME=SwipePads Weekly
# Sends per second throttle (one personalized email per recipient)
MAIL_RATE_PER_SEC=5
# Deployed unsubscribe Worker URL (workers/unsubscribe/)
UNSUBSCRIBE_BASE_URL=https://swipepads-unsubscribe.example.workers.dev
# HMAC secret for unsubscribe links — MUST equal the Worker's UNSUB_SECRET secret
UNSUB_SECRET=your_unsub_secret_here

# Newsletter inbox (news.outplay.game -> newsletter-inbox Worker -> KV)
# Namespace created with: npx wrangler kv namespace create NEWSLETTERS
# Reading uses CF_ACCOUNT_ID + CF_KV_API_TOKEN above (token must cover this namespace)
NEWSLETTER_KV_NAMESPACE_ID=your_newsletters_namespace_id_here
# Scan window in days for inbox emails (digest covers 7, +1 margin)
NEWSLETTER_SINCE_DAYS=8

# Database
DATABASE_PATH=data/articles.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/scraper.log

# Retention (days)
ARTICLE_RETENTION_DAYS=30
