# ──────────────────────────────────────────
# Outplay News Scraper — Environment Config
# ──────────────────────────────────────────
# Copy to .env and fill in your values:
#   cp .env.example .env

# ─── AI API ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# ─── Strapi Cloud CMS ──────────────────
STRAPI_URL=https://your-project.api.strapi.io
STRAPI_TOKEN=your-api-token-here

# ─── Reddit API (OAuth2 app-only) ──────
# Create app at: https://www.reddit.com/prefs/apps
# Type: "script" application
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ─── YouTube Data API v3 ───────────────
# Enable at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# ─── Twitch API (future) ───────────────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ─── Scraper Settings ──────────────────
SCRAPER_USER_AGENT=OutplayNewsScraper/1.0
SCRAPER_RATE_LIMIT_SECONDS=2

# ─── Database ──────────────────────────
DATABASE_PATH=data/articles.db

# ─── Logging ───────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/scraper.log

# ─── Content Settings ─────────────────
ARTICLE_RETENTION_DAYS=30
CONTENT_EXPIRY_DAYS=7
MAX_ARTICLES_PER_GAME=10
